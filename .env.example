# GEMINI_API_KEY / VITE_GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=
NEXT_PUBLIC_GEMINI_API_KEY=
VITE_GEMINI_MODEL=

# GROQ_API_KEY: Chave gratuita da Groq Cloud (console.groq.com) para IA ultra-rápida (Llama 3.3 70B)
GROQ_API_KEY=

# OPENROUTER_API_KEY: Chave da OpenRouter (openrouter.ai) para acesso a modelos abertos e gratuitos
OPENROUTER_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=

# MERCADOPAGO_ACCESS_TOKEN: Access Token de Produção ou Teste do Mercado Pago (inicia com APP_USR-... ou TEST-...)
MERCADOPAGO_ACCESS_TOKEN=

# MERCADOPAGO_PUBLIC_KEY / VITE_MERCADOPAGO_PUBLIC_KEY: Chave pública do Mercado Pago para o frontend (inicia com APP_USR-... ou TEST-...)
MERCADOPAGO_PUBLIC_KEY=
VITE_MERCADOPAGO_PUBLIC_KEY=

# MERCADOPAGO_WEBHOOK_SECRET: Chave secreta opcional para validação de notificações Webhook IPN do Mercado Pago
MERCADOPAGO_WEBHOOK_SECRET=

# MERCADOPAGO_CLIENT_ID: ID da aplicação do Mercado Pago
MERCADOPAGO_CLIENT_ID=

# MERCADOPAGO_CLIENT_SECRET: Client Secret da aplicação do Mercado Pago
MERCADOPAGO_CLIENT_SECRET=

